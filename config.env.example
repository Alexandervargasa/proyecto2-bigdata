# =====================================================================
# Configuración del proyecto. Copie este archivo:
#     cp config.env.example config.env
# y ajuste los valores. Todos los scripts hacen:  source config.env
# NO suba config.env a GitHub (está en .gitignore): tiene la clave de la BD.
# =====================================================================

# --- AWS Academy Learner Lab ---
export AWS_REGION="us-east-1"
export AWS_DEFAULT_REGION="$AWS_REGION"
# Se calcula solo; en Learner Lab la cuenta cambia entre laboratorios.
export ACCOUNT_ID="$(aws sts get-caller-identity --query Account --output text 2>/dev/null)"
# En Learner Lab NO se pueden crear roles IAM: se usan los que ya existen.
export LAB_ROLE_ARN="arn:aws:iam::${ACCOUNT_ID}:role/LabRole"
export LAB_INSTANCE_PROFILE="LabInstanceProfile"
export KEY_NAME="vockey"

# --- Datalake (S3). El nombre del bucket debe ser único en el mundo ---
export BUCKET="clima-colombia-datalake-${ACCOUNT_ID}"
export RAW="s3://${BUCKET}/raw"          # bronze
export TRUSTED="s3://${BUCKET}/trusted"  # silver
export REFINED="s3://${BUCKET}/refined"  # gold
export SCRIPTS="s3://${BUCKET}/scripts"
export ATHENA_OUTPUT="s3://${BUCKET}/athena-results/"

# --- Repositorio (el EC2 lo clona al arrancar) ---
export REPO_URL="https://github.com/SU_USUARIO/proyecto2-bigdata-clima.git"

# --- Red (default VPC) ---
export SG_EC2_NAME="clima-ec2-sg"
export SG_RDS_NAME="clima-rds-sg"

# --- Fuente 1: RDS MariaDB ---
export DB_INSTANCE_ID="clima-mariadb"
export DB_NAME="clima_maestros"
export DB_USER="admin"
export DB_PASSWORD="CambieEstaClave2026"   # mínimo 8 caracteres, sin @ / " ni espacios
export DB_HOST=""   # se llena después de crear el RDS (endpoint)

# --- Fuente 2: EC2 con archivos ---
export EC2_NAME="clima-fuentes"
export EC2_TYPE="t3.small"

# --- Fuente 3: URLs en Internet ---
export OPENMETEO_URL="https://archive-api.open-meteo.com/v1/archive"
export ONI_URL="https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt"
export FECHA_INICIO_HISTORICO="2022-01-01"   # archivos en EC2: 2022-2024
export FECHA_FIN_HISTORICO="2024-12-31"
export FECHA_INICIO_API="2025-01-01"         # API: 2025 hasta hoy-6 días

# --- Glue / Catálogo ---
export GLUE_DB_RAW="clima_raw"
export GLUE_DB_TRUSTED="clima_trusted"
export GLUE_DB_REFINED="clima_refined"
export GLUE_JOB="clima_raw_a_trusted"

# --- EMR ---
export EMR_NAME="clima-emr"
export EMR_RELEASE="emr-7.1.0"   # use una versión disponible en su Learner Lab
export EMR_INSTANCE_TYPE="m5.xlarge"
